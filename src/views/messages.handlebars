<h1>Mensajes</h1>

<form id="messageForm">
  <input type="text" name="user" placeholder="Tu nombre" required />
  <textarea name="message" placeholder="Escribí tu mensaje" maxlength="500" required></textarea>
  <button type="submit">Enviar</button>
</form>

<p id="messagesEmpty" class="empty-state" {{#if messages.length}}hidden{{/if}}>Todavía no hay mensajes.</p>

<section id="messagesList">
  {{#each messages}}
  <article id="{{_id}}" class="message-card">
    <p class="message-meta"><strong>{{user}}</strong> · {{formatDate createdAt}}</p>
    <p class="message-text">{{message}}</p>
    <button type="button" class="delete-message" data-id="{{_id}}">Eliminar</button>
  </article>
  {{/each}}
</section>

<script>
  const messageForm = document.getElementById('messageForm')
  const messagesListElement = document.getElementById('messagesList')

  messageForm.addEventListener('submit', async (event) => {
    event.preventDefault()

    const formData = new FormData(messageForm)
    const data = Object.fromEntries(formData.entries())

    try {
      const response = await fetch('/api/messages', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      })
      const result = await response.json()

      if (response.status === 201) {
        messageForm.elements.message.value = ''
      } else {
        alert(result.message || 'Error al enviar el mensaje')
      }
    } catch (error) {
      alert(error.message)
    }
  })

  messagesListElement.addEventListener('click', async (event) => {
    const button = event.target.closest('.delete-message')
    if (!button) return

    try {
      const response = await fetch(`/api/messages/${button.dataset.id}`, {
        method: 'DELETE'
      })

      if (!response.ok) {
        const result = await response.json()
        alert(result.message || 'Error al eliminar el mensaje')
      }
    } catch (error) {
      alert(error.message)
    }
  })
</script>
