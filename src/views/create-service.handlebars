<p><a href="/views/services">← Volver al listado</a></p>

<h2>Crear servicio</h2>

<form id="form" action="/api/services" method="POST">
  <input type="text" name="name" placeholder="Nombre del servicio" required />
  <textarea name="description" placeholder="Descripcion" required></textarea>
  <input type="number" name="duration" placeholder="Duracion" min="1" required />
  <input type="number" name="price" placeholder="Precio" min="0" required />
  <input type="text" name="category" placeholder="Categoria" required />
  <label for="select">Disponibilidad: </label>
  <select name="available" id="select">
    <option value='true' selected>Disponible</option>
    <option value='false'>No disponible</option>
  </select>
  <button type="submit">Guardar</button>
</form>

<script>
  const form = document.getElementById('form')

  form.addEventListener('submit', async (event) => {
    event.preventDefault()

    const formData = new FormData(form)
    const data = Object.fromEntries(formData.entries())

    data.name = data.name.split(' ').map(word => word.charAt(0).toUpperCase() + word.slice(1)).join(' ')
    data.description = data.description.split(' ').map(word => word.charAt(0).toUpperCase() + word.slice(1)).join(' ')
    data.category = data.category.split(' ').map(word => word.charAt(0).toUpperCase() + word.slice(1)).join(' ')
    data.duration = Number(data.duration)
    data.price = Number(data.price)
    data.available = data.available === 'true'

    try {
      const response = await fetch('/api/services', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      })
      const result = await response.json()

      if (response.status === 201) {
        alert('Servicio creado exitosamente')
        window.location.href = '/views/services'
      } else if (response.status === 400) {
        alert(`${result.message}`)
      }
    } catch (error) {
      alert(error.message)
    }
  })
</script>